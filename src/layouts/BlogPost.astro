---
import Base from './Base.astro';
export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  tags: string[];
}
const { title, description, pubDate, author, tags } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={title} description={description}>
  <article>
    <header class="post-header">
      <div class="meta">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span>·</span>
        <span>{author}</span>
      </div>
      <h1>{title}</h1>
      <p class="description">{description}</p>
      <div class="tags">
        {tags.map(tag => <span class="tag">#{tag}</span>)}
      </div>
    </header>

    <!-- AdSense ad unit — uncomment and replace with your ad unit ID after approval -->
    <!--
    <div class="ad-slot">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="XXXXXXXXXX"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
    -->

    <div class="prose">
      <slot />
    </div>

    <!-- Bottom ad unit -->
    <!--
    <div class="ad-slot">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="XXXXXXXXXX"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
    -->

    <section class="comments">
      <h2>Comments</h2>
      <script is:inline
        src="https://giscus.app/client.js"
        data-repo="deveshanant/goliveapp-blog"
        data-repo-id="R_kgDOTAGqQg"
        data-category="Announcements"
        data-category-id="DIC_kwDOTAGqQs4DAeN9"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="dark"
        data-lang="en"
        crossorigin="anonymous"
        async>
      </script>
    </section>
  </article>
</Base>

<style>
  .post-header {
    margin-bottom: 2.5rem;
    padding: 2rem 1.75rem;
    background: linear-gradient(135deg, rgba(110,231,183,0.05) 0%, rgba(129,140,248,0.08) 100%);
    border: 1px solid var(--border);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
  }
  .post-header::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--grad);
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  h1 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1.25;
    margin-bottom: 0.75rem;
    background: linear-gradient(135deg, #fff 40%, var(--accent2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .description {
    color: var(--muted);
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tag {
    background: rgba(129,140,248,0.1);
    border: 1px solid rgba(129,140,248,0.25);
    border-radius: 20px;
    padding: 0.15rem 0.6rem;
    font-size: 0.75rem;
    color: var(--accent2);
  }

  .ad-slot {
    margin: 2rem 0;
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: 6px;
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 0.8rem;
  }

  /* Prose styles */
  .prose :global(h2) {
    font-size: 1.5rem;
    margin: 2.5rem 0 1rem;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    border-left: 3px solid var(--accent);
    padding-left: 0.75rem;
  }
  .prose :global(h3) {
    font-size: 1.15rem;
    margin: 1.75rem 0 0.75rem;
    color: var(--accent3);
  }
  .prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: 10px;
    margin: 1.5rem 0;
    border: 1px solid var(--border);
  }
  .prose :global(p) { margin-bottom: 1.2rem; }
  .prose :global(ul), .prose :global(ol) {
    margin: 1rem 0 1.2rem 1.5rem;
  }
  .prose :global(li) { margin-bottom: 0.4rem; }
  .prose :global(a) { color: var(--accent2); text-decoration: underline; }

  .prose :global(code) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.1em 0.35em;
    font-size: 0.88em;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    color: var(--accent);
  }

  .prose :global(pre) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.25rem 0;
  }
  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.875rem;
    color: var(--text);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--accent2);
    padding-left: 1rem;
    color: var(--muted);
    margin: 1.25rem 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }
  .prose :global(th) {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.6rem 1rem;
    text-align: left;
    color: var(--accent);
  }
  .prose :global(td) {
    border: 1px solid var(--border);
    padding: 0.6rem 1rem;
  }
  .prose :global(tr:nth-child(even)) { background: var(--surface); }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }
  .prose :global(input[type="checkbox"]) { margin-right: 0.5rem; }

  .comments {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid transparent;
    border-image: linear-gradient(90deg, var(--accent2), var(--accent3), transparent) 1;
  }
  .comments h2 {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
    background: var(--grad2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
