---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Base title="GoLiveApp — DevOps & SRE Guides">
  <section class="hero">
    <h1>Ship with confidence.</h1>
    <p>Practical DevOps and SRE guides from engineers who've been paged at 2am.</p>
  </section>

  <section class="about">
    <h2>What GoLiveApp covers</h2>
    <p>
      GoLiveApp publishes in-depth technical guides for DevOps engineers and SREs running production
      systems on Kubernetes. Each post focuses on a specific operational problem — zero-downtime
      deployments, cluster resilience, incident response, cost optimization — and walks through
      real configurations you can apply directly.
    </p>
    <p>
      These guides assume you're already running Kubernetes in production, not learning it for the
      first time. No hello-world examples. No theory without working YAML. Every post includes the
      failure modes, the edge cases, and the production gotchas that official docs leave out.
    </p>
    <div class="topics">
      <div class="topic">
        <span class="topic-icon">⚙</span>
        <div>
          <strong>Kubernetes Operations</strong>
          <p>Rolling updates, probes, graceful shutdown, HPA, PodDisruptionBudgets, topology spread</p>
        </div>
      </div>
      <div class="topic">
        <span class="topic-icon">☁</span>
        <div>
          <strong>AWS EKS</strong>
          <p>Cluster upgrades, rollbacks, managed node groups, Fargate, Auto Mode</p>
        </div>
      </div>
      <div class="topic">
        <span class="topic-icon">📊</span>
        <div>
          <strong>SRE Practices</strong>
          <p>SLOs, error budgets, on-call runbooks, incident response, observability</p>
        </div>
      </div>
      <div class="topic">
        <span class="topic-icon">💰</span>
        <div>
          <strong>Cost Optimization</strong>
          <p>Spot instances, resource right-sizing, Karpenter, namespace quotas</p>
        </div>
      </div>
    </div>
  </section>

  <section class="posts">
    <h2>Latest Posts</h2>
    <ul>
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.slug}`}>
            <h3>{post.data.title}</h3>
            <p class="desc">{post.data.description}</p>
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <div class="tags">
                {post.data.tags.slice(0, 3).map(tag => <span class="tag">#{tag}</span>)}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding: 3.5rem 0 3rem;
    margin-bottom: 2.5rem;
    position: relative;
  }
  .hero::after {
    content: '';
    display: block;
    height: 1px;
    background: linear-gradient(90deg, var(--accent), var(--accent2), transparent);
    margin-top: 3rem;
    opacity: 0.5;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.75rem;
    line-height: 1.15;
    background: linear-gradient(135deg, #fff 30%, var(--accent2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero p {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 520px;
  }

  .about {
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .about h2 {
    font-size: 1.1rem;
    color: #fff;
    margin-bottom: 1rem;
  }
  .about > p {
    color: var(--muted);
    font-size: 0.975rem;
    margin-bottom: 1rem;
    max-width: 640px;
    line-height: 1.75;
  }
  .topics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 520px) { .topics { grid-template-columns: 1fr; } }
  .topic {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.9rem 1rem;
  }
  .topic-icon {
    font-size: 1.1rem;
    margin-top: 0.1rem;
    flex-shrink: 0;
  }
  .topic strong {
    display: block;
    font-size: 0.9rem;
    color: var(--accent2);
    margin-bottom: 0.2rem;
  }
  .topic p {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.5;
  }

  .posts h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .posts h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
  }

  .posts ul { list-style: none; display: flex; flex-direction: column; gap: 1rem; }

  .posts li a {
    display: block;
    padding: 1.25rem 1.25rem 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent2);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    transition: border-left-color 0.2s, transform 0.15s, box-shadow 0.2s;
  }
  .posts li:nth-child(3n+1) a { border-left-color: var(--accent); }
  .posts li:nth-child(3n+2) a { border-left-color: var(--accent2); }
  .posts li:nth-child(3n+3) a { border-left-color: var(--accent3); }

  .posts li a:hover {
    transform: translateX(3px);
    box-shadow: 0 4px 24px rgba(0,0,0,0.3);
    border-color: var(--accent2);
    text-decoration: none;
  }

  .posts li a h3 {
    font-size: 1.1rem;
    color: #fff;
    margin-bottom: 0.35rem;
    transition: color 0.15s;
  }
  .posts li a:hover h3 { color: var(--accent2); }

  .desc { color: var(--muted); font-size: 0.9rem; margin-bottom: 0.75rem; }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .post-meta time { font-size: 0.78rem; color: var(--muted); }
  .tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .tag {
    background: rgba(110,231,183,0.08);
    border: 1px solid rgba(110,231,183,0.2);
    border-radius: 20px;
    padding: 0.1rem 0.55rem;
    font-size: 0.72rem;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
</style>
