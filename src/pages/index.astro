---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Base title="GoLiveApp — DevOps & SRE Guides">
  <section class="hero">
    <h1>Ship with confidence.</h1>
    <p>Practical DevOps and SRE guides from engineers who've been paged at 2am.</p>
  </section>

  <section class="posts">
    <h2>Latest Posts</h2>
    <ul>
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.slug}`}>
            <h3>{post.data.title}</h3>
            <p class="desc">{post.data.description}</p>
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <div class="tags">
                {post.data.tags.slice(0, 3).map(tag => <span class="tag">#{tag}</span>)}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding: 3.5rem 0 3rem;
    margin-bottom: 2.5rem;
    position: relative;
  }
  .hero::after {
    content: '';
    display: block;
    height: 1px;
    background: linear-gradient(90deg, var(--accent), var(--accent2), transparent);
    margin-top: 3rem;
    opacity: 0.5;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.75rem;
    line-height: 1.15;
    background: linear-gradient(135deg, #fff 30%, var(--accent2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero p {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 520px;
  }

  .posts h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .posts h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
  }

  .posts ul { list-style: none; display: flex; flex-direction: column; gap: 1rem; }

  .posts li a {
    display: block;
    padding: 1.25rem 1.25rem 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent2);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    transition: border-left-color 0.2s, transform 0.15s, box-shadow 0.2s;
  }
  .posts li:nth-child(3n+1) a { border-left-color: var(--accent); }
  .posts li:nth-child(3n+2) a { border-left-color: var(--accent2); }
  .posts li:nth-child(3n+3) a { border-left-color: var(--accent3); }

  .posts li a:hover {
    transform: translateX(3px);
    box-shadow: 0 4px 24px rgba(0,0,0,0.3);
    border-color: var(--accent2);
    text-decoration: none;
  }

  .posts li a h3 {
    font-size: 1.1rem;
    color: #fff;
    margin-bottom: 0.35rem;
    transition: color 0.15s;
  }
  .posts li a:hover h3 { color: var(--accent2); }

  .desc { color: var(--muted); font-size: 0.9rem; margin-bottom: 0.75rem; }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .post-meta time { font-size: 0.78rem; color: var(--muted); }
  .tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .tag {
    background: rgba(110,231,183,0.08);
    border: 1px solid rgba(110,231,183,0.2);
    border-radius: 20px;
    padding: 0.1rem 0.55rem;
    font-size: 0.72rem;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
</style>
